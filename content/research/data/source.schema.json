{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:od-toirog:research-source:1.0",
  "title": "Research source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "author",
    "url",
    "kind",
    "accessed",
    "review_status",
    "supports",
    "limitations",
    "independent_work_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "accessed": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "type": "string",
      "minLength": 1
    },
    "supports": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "independent_work_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
