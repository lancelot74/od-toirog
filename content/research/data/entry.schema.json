{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:od-toirog:research-entry:1.0",
  "title": "Od Toirog research entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "title",
    "summary",
    "traditions",
    "evidence_status",
    "source_refs",
    "details",
    "tags",
    "product_use",
    "locale",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "copy",
        "example",
        "method",
        "spread",
        "symbol",
        "taboo",
        "tarot",
        "term",
        "tradition",
        "translation",
        "vocabulary"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_status": {
      "type": "string",
      "minLength": 1
    },
    "product_use": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "educational",
        "editorial",
        "review_required"
      ]
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "traditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "details": {
      "type": "object"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "scope"
        ],
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        }
      }
    }
  }
}
